{
  "name": "max-price-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Demo app for Meta's max price on WhatsApp marketing messages, via 360dialog",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pmartinonales/max-price-lab.git"
  },
  "bugs": {
